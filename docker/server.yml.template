# =============================================================================
# mailadmin (mail) server configuration template
# Copy to /etc/webappsgo/mail/server.yml (root/service)
#      or ~/.config/webappsgo/mail/server.yml (user mode)
# =============================================================================
#
# Rules:
#   - All comments go ABOVE the setting, NEVER inline
#   - Config file is server.yml (not .yaml — auto-migrated if .yaml found)
#   - Boolean values accept: true/false, yes/no, on/off, enabled/disabled, 1/0
#   - Passwords/secrets are NEVER stored here — use the database or env vars
#   - Port is saved here after first-run random selection (64000-64999 range)
#   - Database is the source of truth; server.yml is a cache/backup

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

server:
  # Default: random unused port in 64000-64999 range (saved on first run)
  # Dual port: "8090,8443" (HTTP,HTTPS)
  port: 64580

  # Auto-detected from host on first run (reverse proxy headers -> DOMAIN env -> hostname)
  fqdn: ""

  # Listen on all interfaces (IPv4 and IPv6)
  address: "[::]"

  # production or development
  mode: production

  # Admin panel path — must be [a-z0-9_-] only, no slashes
  admin_path: admin

  # API version prefix (used in /api/{api_version}/ routes)
  api_version: v1

  healthz:
    root:
      # When true, /healthz aliases the canonical /server/healthz handler (never redirects)
      enabled: false

  # Branding and SEO
  branding:
    title: "mailadmin"
    tagline: ""
    description: ""
  seo:
    keywords: []

  # System user/group (auto = detected from process or config at runtime)
  user: "{auto}"
  group: "{auto}"

  # Write PID file on startup
  pidfile: true

  # Daemonize (detach from terminal) — false recommended for service managers
  daemonize: false

  # Admin panel credentials are stored in the database (admins table), NOT here
  admin:
    email: admin@localhost

  # SSL/TLS configuration
  ssl:
    enabled: false

    # cert/key: manual override paths (leave empty for auto-detection)
    # Auto-detection order:
    #   /etc/letsencrypt/live/{fqdn}/     — system manages (certbot)
    #   {config_dir}/ssl/letsencrypt/{fqdn}/ — app manages (auto-renew)
    #   {config_dir}/ssl/local/{fqdn}/    — user manages (no auto-renew)
    cert: ""
    key: ""

    # Minimum TLS version: TLS1.2 or TLS1.3
    min_version: "TLS1.2"

    letsencrypt:
      enabled: false
      email: admin@localhost
      # challenge type: http-01, tls-alpn-01, dns-01
      challenge: http-01
      # use staging server for testing
      staging: false

  # Maintenance mode self-healing settings
  maintenance:
    self_healing:
      enabled: true
      # seconds between retry attempts
      retry_interval: 30s
      # 0 = unlimited retries
      max_attempts: 0
    cleanup:
      # trigger cleanup when disk usage exceeds this percentage
      disk_threshold: 90
      # delete logs older than this many days during emergency cleanup
      log_retention_days: 7
      # keep this many backups during emergency cleanup
      backup_keep_count: 5
    notify:
      on_enter: true
      on_exit: true

  # Background task scheduler (built-in, no external cron/systemd timers)
  scheduler:
    enabled: true
    tasks:
      geoip_update:
        enabled: true
        # Weekly: Sunday 3:00 AM
        schedule: "0 3 * * 0"
        retry_on_fail: true
        retry_delay: 1h
      blocklist_update:
        enabled: true
        # Daily: 4:00 AM
        schedule: "0 4 * * *"
        retry_on_fail: true
        retry_delay: 1h
      cve_update:
        enabled: true
        # Daily: 5:00 AM
        schedule: "0 5 * * *"
        retry_on_fail: true
        retry_delay: 1h
      log_rotation:
        enabled: true
        # Daily: midnight
        schedule: "0 0 * * *"
        max_age: 30d
        max_size: 100MB
      session_cleanup:
        enabled: true
        # Hourly
        schedule: "@hourly"
      backup:
        enabled: true
        # Daily: 2:00 AM
        schedule: "0 2 * * *"
        # number of backups to keep
        retention: 4
      ssl_renewal:
        enabled: true
        # Daily: 3:00 AM (after backup)
        schedule: "0 3 * * *"
        # renew this many days before expiry
        renew_before: 7d
      health_check:
        enabled: true
        # Every 5 minutes
        schedule: "*/5 * * * *"
      tor_health:
        enabled: true
        # Every 10 minutes
        schedule: "*/10 * * * *"

  # Rate limiting
  rate_limit:
    enabled: true
    read:
      # requests per minute per IP
      requests: 120
      window: 60
    write:
      # requests per minute per IP
      requests: 10
      window: 60
    health:
      # requests per minute per IP for health/status endpoints
      requests: 120
      window: 60
    # absolute per-IP ceiling across all endpoint types (per minute)
    global_burst: 240
    auth:
      login:
        requests: 5
        # 15-minute window
        window: 900
      password_reset:
        requests: 3
        # 1-hour window
        window: 3600
      registration:
        requests: 5
        # 1-hour window
        window: 3600

  # Database connection
  # driver options: file (SQLite default), sqlite, postgres, mysql
  # For SQLite (default): only driver: file is needed; path is auto-managed
  # For PostgreSQL/MySQL: set host, port, name, username; use env var for password
  database:
    driver: file
    # host: ""
    # port: 5432
    # name: mail
    # username: mail
    # password: ${DB_PASSWORD}
    # sslmode: require

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

web:
  ui:
    # Theme: dark (default), light, auto
    theme: dark
  # CORS allowed origins (* = all)
  cors: "*"
